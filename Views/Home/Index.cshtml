@model _25DH230146_MyStore.Models.ViewModel.HomeProductVM

@{
    ViewBag.Title = "Customer Home Page";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<!-- PHẦN BANNER -->
<section class="container-fluid banner" style="background-color: #f5f5f5;
padding: 40px 0; text-align: center;">
    <div class="banner-container">
        <h2>Chào mừng đến trang web E-commerce</h2>
        <p>Mua sắm trực tuyến với hàng ngàn sản phẩm đa dạng và chất lượng</p>
        <a href="#" class="btnBanner" style="background-color: darkorange;
color: white; padding: 10px 20px; text-decoration: none; font-weight: bold;">Bắt đầu mua sắm</a>
    </div>
</section>

<!-- PHẦN TÌM KIẾM SẢN PHẨM -->
<section class="container-fluid searchProd" style="text-align: center; margin: 20px 0;">
    <h2>Tìm kiếm sản phẩm</h2>
    @using (Html.BeginForm("Index", "Home", FormMethod.Get))
    {
        <div class="form-group search-container" style="display: flex;
justify-content: center; align-items: center;">
            @Html.TextBoxFor(m => m.SearchTerm,
           new { @class = "search-input form-control", style = "width: 500px; display: inline-block;",
               placeholder = "Nhập tên, mô tả hoặc chủng loại sản phẩm" })
            <button type="submit" class="search-button btn btn-primary" style="margin-left: 5px;">
            Tìm kiếm
            </button>
        </div>
    }
</section>
<hr />

<!-- PHẦN SẢN PHẨM NỔI BẬT -->
@Html.Partial("_PVFeatureProduct", Model)

<!-- PHẦN SẢN PHẨM MỚI -->
@Html.Partial("_PVNewProduct", Model)