@model _25DH230146_MyStore.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc

@if (Model.TopProducts != null && Model.TopProducts.Any())
{
    <section class="container-fluid listProduct">
        <h4 style="font-weight:bold;">Sản phẩm bán chạy</h4>
        <ul class="list-container" style="list-style:none; padding:0;">
            @foreach (var product in Model.TopProducts)
            {
                <li class="lproduct-item" style="margin-bottom:15px; display:flex;">
                    <div style="margin-right:10px;">
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Html.DisplayFor(modelItem => product.ProductImage)"
                                 style="max-height:80px;" />
                        </a>
                    </div>
                    <div>
                        <h5 style="font-weight:bold;">@Html.DisplayFor(modelItem => product.ProductName)
                        </h5>
                        <p class="prodSale" style="color:red;">@Html.DisplayFor(modelItem =>
                                                          product.ProductPrice)</p>
                    </div>
                </li>
            }
        </ul>
    </section>

    <!-- Phân trang sản phẩm bán chạy -->
    <div class="pagination-container">
        @Html.PagedListPager(Model.TopProducts, page => Url.Action("ProductDetails",
       new { id = Model.product.ProductID, quantity = Model.quantity, page }))
    </div>
}
