@model _25DH230146_MyStore.Models.ViewModel.HomeProductVM

<!-- Hiển thị danh sách sản phẩm nổi bật -->
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <section class="container-fluid featureProd">
        <h2>Sản phẩm nổi bật</h2>
        <div class="feature-container">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="fproduct-item">
                    <div>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                            <img src="@Html.DisplayFor(modelItem => product.ProductImage)"
                                 alt="@product.ProductName" />
                        </a>
                    </div>
                    <div>
                        <p class="prodPrice">@Html.DisplayFor(modelItem =>
                                        product.ProductPrice)</p>
                        <p class="prodName">@Html.DisplayFor(modelItem =>
                                       product.ProductName)</p>
                        <p class="prodCate">@Html.DisplayFor(modelItem =>
                                       product.Category.CategoryName)</p>
                        <p class="prodSale">Đã bán: &nbsp; @Html.DisplayFor(modelItem =>
                                                      product.OrderDetails.Count)</p>
                    </div>
                </div>
            }
        </div>
    </section>
    <hr />
}
