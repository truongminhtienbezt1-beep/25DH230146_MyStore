@model _25DH230146_MyStore.Models.ViewModel.HomeProductVM

<!-- Hiển thị danh sách sản phẩm nổi bật -->
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <section class="container-fluid featureProd">
        <h2 class="mb-4 text-center">Sản phẩm nổi bật</h2>

        <div class="row feature-container">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="col-md-3 col-sm-6 mb-4 fproduct-item">
                    <div class="card h-100 text-center" style="border: 1px solid #eee; padding: 15px; border-radius: 8px
; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">

                        <!-- Hình ảnh sản phẩm -->
                        <div class="img-container" style="height: 250px; overflow: hidden; display: flex; align-items: center;
justify-content: center;">
                            <a href="@Url.Action("ProductDetail", "Home", new { id = product.ProductID })">
                                <img src="@Html.DisplayFor(modelItem => product.ProductImage)"
                                     class="img-fluid"
                                     style="max-height: 100%; max-width: 100%; object-fit: contain;"
                                     alt="@product.ProductName" />
                            </a>
                        </div>

                        <!-- Thông tin chi tiết sản phẩm -->
                        <div class="card-body" style="padding-top: 15px;">
                            <h5 class="prodName" style="font-weight: bold; font-size: 1.1em; margin-bottom: 10px;
height: 40px; overflow: hidden;">
                                @Html.DisplayFor(modelItem => product.ProductName)
                            </h5>
                            <p class="prodPrice text-danger" style="font-size: 1.2em; font-weight: bold; margin-bottom: 5px;">
                                @product.ProductPrice.ToString("N0") VNĐ
                            </p>
                            <p class="prodCate text-muted" style="margin-bottom: 5px; font-size: 0.9em;">
                                @Html.DisplayFor(modelItem => product.Category.CategoryName)
                            </p>
                            <p class="prodSale text-muted" style="margin-bottom: 0; font-size: 0.9em;">
                                Đã bán: @product.OrderDetails.Count
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
    <hr />
}