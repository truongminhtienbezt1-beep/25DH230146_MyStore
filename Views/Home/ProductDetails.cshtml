@model _25DH230146_MyStore.Models.ViewModel.ProductDetailsVM
@{
    ViewBag.Title = "ProductDetails";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
<div class="container-fluid pro" style="padding: 20px;">
    <div class="row" style="display:flex;">
        <!-- Khối bên trái: Ảnh sản phẩm -->
        <div class="col-md-3 pro-section" style="flex: 1;">
            <img src="@Model.product.ProductImage" style="max-width:100%; height:auto;" />
        </div>

        <!-- Khối ở giữa: Thông tin sản phẩm -->
        <div class="col-md-5 pro-section" style="flex: 2; padding: 0 20px;">
            <h4><strong>@Html.DisplayFor(model => model.product.ProductName)</strong></h4>
            <p class="pro-sale">Đã bán: &nbsp; @Model.product.OrderDetails.Count</p>
            <p class="pro-price" style="color:red; font-size:larger; font-weight:bolder;">
            @Model.product.ProductPrice.ToString("C")</p>
            <p>Tủ sách: &nbsp; @Model.product.Category.CategoryName</p>
            <hr />
            <h5><strong>Mô tả</strong></h5>
            <p>@Model.product.ProductDescription</p>
            <hr />
            <div>@Html.Partial("_PVRelatedProduct", Model)</div>
        </div>

        <!-- Khối bên phải: Chọn số lượng, tạm tính và nút Thêm vào giỏ -->
        <div class="col-md-4 pro-section" style="flex: 1; border-left: 1px solid #ddd;
padding-left: 20px;">
            @using (Html.BeginForm("ProductDetails", "Home", FormMethod.Get))
            {
                <h4><strong>Số lượng</strong></h4>
                <p>
                    @Html.TextBoxFor(model => model.quantity,
                   new { @class = "form-control", @type = "number", @min = 1 })
                </p>
                <h4><strong>Tạm tính</strong></h4>
                <p>@Model.estimatedValue.ToString("N0")</p>
                <p>
                    @Html.ActionLink("Thêm vào giỏ hàng", "AddToCart", "Cart",
                   new { id = Model.product.ProductID, quantity = Model.quantity },
                   new { @class = "btn btn-info" })
                </p>
            }
            <hr />
            <div>@Html.Partial("_PVTopProduct", Model)</div>
        </div>
    </div>
</div>