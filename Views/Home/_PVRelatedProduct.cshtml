@model _25DH230146_MyStore.Models.ViewModel.ProductDetailsVM
@using PagedList.Mvc

@if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
{
    <section class="container-fluid featureProd">
        <h4 style="font-weight:bold;">Sản phẩm tương tự</h4>
        <ul class="feature-container" style="display:flex; list-style:none; padding:0;">
            @foreach (var product in Model.RelatedProducts)
            {
                <li class="fproduct-item" style="margin-right:15px;">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Html.DisplayFor(modelItem => product.ProductImage)"
                                 style="max-height:150px;" />
                        </a>
                    </div>
                    <div>
                        <h5 style="font-weight:bold;">@Html.DisplayFor(modelItem => product.ProductName)
                        </h5>
                        <p class="prodSale" style="color:red;">@Html.DisplayFor(modelItem =>
                                                          product.ProductPrice)</p>
                    </div>
                </li>
            }
        </ul>
    </section>
}
