@{
    // Lấy thông tin giỏ hàng từ Session[cite: 3]
    var cart = Session["Cart"] as _25DH230146_MyStore.Models.ViewModel.Cart;

    // Tạo đối tượng ViewBag.pmmodel dạng PersonalMenuVM để quản lý menu cá nhân[cite: 3]
    ViewBag.pmmodel = new _25DH230146_MyStore.Models.ViewModel.PersonalMenuVM
    {
        IsLoggedIn = User.Identity.IsAuthenticated,
        Username = User.Identity.IsAuthenticated ? User.Identity.Name : string.Empty
    };

    // Nếu giỏ hàng có sản phẩm thì gán tổng số lượng mặt hàng vào CartCount[cite: 3]
    if (cart != null && cart.Items.Any())
    {
        ViewBag.pmmodel.CartCount = cart.Items.Count();
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - My Store</title>
    <!-- Nhúng các file CSS, Bootstrap và FontAwesome nếu cần -->
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        /* CSS cơ bản cho Menu Dropdown tài khoản */
        ul {
            list-style-type: none;
            padding: 0;
            margin: 0;
            display: flex;
        }

        li {
            margin-right: 20px;
            position: relative;
        }

        .dropdown-content {
            display: none;
            position: absolute;
            background-color: #f9f9f9;
            min-width: 160px;
            box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
            z-index: 1;
        }

            .dropdown-content a {
                color: black;
                padding: 12px 16px;
                text-decoration: none;
                display: block;
            }

                .dropdown-content a:hover {
                    background-color: #f1f1f1;
                }

        .dropdown:hover .dropdown-content {
            display: block;
        }
    </style>
</head>
<body>
    <!-- PHẦN HEADER / MENU -->
    <div class="navbar navbar-default navbar-fixed-top" style="background-color: lightgreen; padding: 10px 20px;">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center;">

            <!-- Logo / Trang chủ -->
            <div class="navbar-header">
                <a href="@Url.Action("Index", "Home")" class="navbar-brand" style="font-weight: bold; font-size: 24px;">FASTOR</a>
            </div>

            <!-- Các Menu điều hướng bên phải -->
            <div class="navbar-collapse">
                <ul class="nav navbar-nav" style="align-items: center;">
                    <!-- Nút Trang chủ -->
                    <li>
                        <a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i> Trang chủ</a>
                    </li>

                    <!-- Menu Tài khoản (Dropdown xử lý theo trạng thái đăng nhập) -->
                    <li class="dropdown">
                        <a href="javascript:void(0)" id="account-name">
                            @if (ViewBag.pmmodel.IsLoggedIn)
                            {
                                <text><i class="fas fa-user"></i> Hello, </text>@ViewBag.pmmodel.Username
                            }
                            else
                            {
                                <text><i class="fas fa-user"></i> Tài khoản</text>
                            }
                        </a>
                        <div class="dropdown-content">
                            @if (ViewBag.pmmodel.IsLoggedIn)
                            {
                                <a href="@Url.Action("Profile", "Account")">Thông tin tài khoản</a>
                                <a href="@Url.Action("OrderHistory", "Order")">Lịch sử mua hàng</a>
                                <a href="@Url.Action("Logout", "Account")">Đăng xuất</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Register", "Account")">Đăng ký</a>
                                <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
                            }
                        </div>
                    </li>

                    <!-- Menu Giỏ hàng hiển thị số lượng -->
                    <li>
                        <a href="@Url.Action("Index", "Cart")">
                            <i class="fas fa-shopping-cart"></i> Giỏ hàng
                            (<span id="cart-count">@ViewBag.pmmodel.CartCount</span>)
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- PHẦN NỘI DUNG ĐỘNG (RENDER BODY) -->
    <div class="container" style="margin-top: 80px; min-height: 500px;">
        @RenderBody()
    </div>

    <!-- PHẦN FOOTER -->
    <hr />
    <footer style="text-align: center; padding: 20px; background-color: #e0e0e0;">
        <p>&copy; 2026 - Tên ứng dụng</p>
        <p><strong>Contact</strong></p>
        <p>Tên các thành viên trong nhóm</p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>