@model _25DH230146_MyStore.Models.ViewModel.StatisticsVM

@{
    ViewBag.Title = "Trang thống kê";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid" style="padding: 20px;">
    <h2 style="background-color: #dff0d8; padding: 10px; margin-bottom: 20px;">THỐNG KÊ HỆ THỐNG</h2>

    <!-- 4 Thẻ tổng quan -->
    <div class="row text-center" style="margin-bottom: 25px;">
        <div class="col-md-3">
            <div class="panel panel-info">
                <div class="panel-heading"><strong>TỔNG DANH MỤC</strong></div>
                <div class="panel-body"><h3>@Model.TotalCategories</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="panel panel-success">
                <div class="panel-heading"><strong>TỔNG SẢN PHẨM</strong></div>
                <div class="panel-body"><h3>@Model.TotalProducts</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="panel panel-warning">
                <div class="panel-heading"><strong>TỔNG ĐƠN HÀNG</strong></div>
                <div class="panel-body"><h3>@Model.TotalOrders</h3></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="panel panel-danger">
                <div class="panel-heading"><strong>TỔNG DOANH THU</strong></div>
                <div class="panel-body"><h3 class="text-danger">@Model.TotalRevenue.ToString("N0") đ</h3></div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Bảng thống kê hàng hóa theo từng loại -->
        <div class="col-md-7">
            <h4><strong>THỐNG KÊ HÀNG HÓA TỪNG LOẠI</strong></h4>
            <table class="table table-bordered table-striped">
                <thead style="background-color: #dff0d8;">
                    <tr>
                        <th>Loại hàng</th>
                        <th>Số lượng</th>
                        <th>Giá cao nhất</th>
                        <th>Giá thấp nhất</th>
                        <th>Giá trung bình</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CategoryStats)
                    {
                        <tr>
                            <td>@item.CategoryName</td>
                            <td>@item.ProductCount</td>
                            <td>@item.MaxPrice.ToString("N0")</td>
                            <td>@item.MinPrice.ToString("N0")</td>
                            <td>@item.AvgPrice.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Biểu đồ tỷ lệ sản phẩm theo danh mục -->
        <div class="col-md-5">
            <h4><strong>BIỂU ĐỒ THỐNG KÊ</strong></h4>
            <div id="piechart" style="width: 100%; height: 350px; border: 1px solid #eee;"></div>
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        google.charts.load('current', { 'packages': ['corechart'] });
        google.charts.setOnLoadCallback(drawChart);

        function drawChart() {
            var rawData = @Html.Raw(Json.Encode(Model.CategoryStats));
            var chartRows = [['Loại hàng', 'Số lượng']];

            for (var i = 0; i < rawData.length; i++) {
                chartRows.push([rawData[i].CategoryName, rawData[i].ProductCount]);
            }

            var data = google.visualization.arrayToDataTable(chartRows);
            var options = {
                title: 'TỶ LỆ HÀNG HÓA THEO DANH MỤC',
                is3D: true
            };

            var chart = new google.visualization.PieChart(document.getElementById('piechart'));
            chart.draw(data, options);
        }
    </script>
}