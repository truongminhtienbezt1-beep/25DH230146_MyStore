@model _25DH230146_MyStore.Models.Order

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid" style="padding: 20px;">
    <h2>CHI TIẾT ĐƠN HÀNG</h2>
    <hr />

    <div class="row">
        <!-- Cột trái: Thông tin đơn hàng -->
        <div class="col-md-4">
            <h4>THÔNG TIN ĐƠN HÀNG</h4>
            <dl class="dl-horizontal">
                <dt>Ngày đặt hàng</dt>
                <dd>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt>Tên khách hàng</dt>
                <dd>@Model.Customer.CustomerName</dd>

                <dt>Tổng giá trị</dt>
                <dd>@Model.TotalAmount.ToString("N2")</dd>

                <dt>Phương thức thanh toán</dt>
                <dd>@Model.PaymentMethod</dd>

                <dt>Trạng thái thanh toán</dt>
                <dd>@Model.PaymentStatus</dd>

                <dt>Phương thức giao hàng</dt>
                <dd>@Model.DeliveryMethod</dd>

                <dt>Địa chỉ giao hàng</dt>
                <dd>@Model.ShippingAddress</dd>
            </dl>
        </div>

        <!-- Cột phải: Danh sách sản phẩm trong đơn -->
        <div class="col-md-8">
            <table class="table">
                <thead>
                    <tr>
                        <th colspan="2">Sản phẩm</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        var thanhTien = item.Quantity * item.UnitPrice;
                        <tr>
                            <td style="width: 100px;">
                                <img src="@item.Product.ProductImage" alt="@item.Product.ProductName" style="max-height: 100px;" />
                            </td>
                            <td>@item.Product.ProductName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice.ToString("N0")</td>
                            <td>@thanhTien.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="margin-top: 20px;">
        @Html.ActionLink("Cập nhật trạng thái", "Edit", "Orders", new { id = Model.OrderID }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Quay lại danh sách", "Index", "Orders", null, new { @class = "btn btn-primary" })
    </div>
</div>