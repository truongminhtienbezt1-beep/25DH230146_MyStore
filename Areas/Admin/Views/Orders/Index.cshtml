@model PagedList.IPagedList<_25DH230146_MyStore.Models.Order>
@using PagedList.Mvc

@{
    ViewBag.Title = "Danh sách đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid" style="padding: 20px;">
    <!-- Form Tìm kiếm -->
    @using (Html.BeginForm("Index", "Orders", FormMethod.Get, new { @class = "row", style = "margin-bottom: 20px;" }))
    {
        <div class="col-md-3">
            <label><strong>Tên khách hàng</strong></label>
            <input type="text" name="customerName" value="@ViewBag.CustomerName" class="form-control" placeholder="Nhập tên khách hàng..." />
        </div>
        <div class="col-md-3">
            <label><strong>Trạng thái thanh toán</strong></label>
            <select name="paymentStatus" class="form-control">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Chưa thanh toán" @(ViewBag.PaymentStatus == "Chưa thanh toán" ? "selected" : "")>Chưa thanh toán</option>
                <option value="Thanh toán tiền mặt" @(ViewBag.PaymentStatus == "Thanh toán tiền mặt" ? "selected" : "")>Thanh toán tiền mặt</option>
                <option value="Thanh toán paypal" @(ViewBag.PaymentStatus == "Thanh toán paypal" ? "selected" : "")>Thanh toán paypal</option>
                <option value="Trả góp" @(ViewBag.PaymentStatus == "Trả góp" ? "selected" : "")>Trả góp</option>
                <option value="Đang xử lý" @(ViewBag.PaymentStatus == "Đang xử lý" ? "selected" : "")>Đang xử lý</option>
                <option value="Đang vận chuyển" @(ViewBag.PaymentStatus == "Đang vận chuyển" ? "selected" : "")>Đang vận chuyển</option>
                <option value="Đã giao" @(ViewBag.PaymentStatus == "Đã giao" ? "selected" : "")>Đã giao</option>
                <option value="Đã hủy" @(ViewBag.PaymentStatus == "Đã hủy" ? "selected" : "")>Đã hủy</option>
            </select>
        </div>
        <div class="col-md-3">
            <label><strong>Ngày đặt hàng</strong></label>
            <input type="date" name="orderDate" value="@ViewBag.OrderDate" class="form-control" />
        </div>
        <div class="col-md-3" style="display: flex; align-items: flex-end;">
            <button type="submit" class="btn btn-primary" style="margin-top: 25px;">Tìm kiếm</button>
        </div>
    }

    <h2 style="background-color: #dff0d8; padding: 10px; margin-bottom: 15px;">DANH SÁCH ĐƠN HÀNG</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">
            <strong>KHÔNG CÓ</strong>
        </div>
    }
    else
    {
        <table class="table table-bordered table-hover">
            <thead style="background-color: #dff0d8;">
                <tr>
                    <th>Ngày đặt hàng</th>
                    <th>Tên khách hàng</th>
                    <th>Tổng giá trị</th>
                    <th>Trạng thái thanh toán</th>
                    <th>Phương thức giao hàng</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Customer.CustomerName</td>
                        <td>@item.TotalAmount.ToString("N2")</td>
                        <td>@item.PaymentStatus</td>
                        <td>@item.DeliveryMethod</td>
                        <td>
                            @Html.ActionLink("Chi tiết đơn hàng", "Details", "Orders", new { id = item.OrderID }, null)
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Phân trang 15 đơn hàng/trang -->
        <div class="pagination-container">
            @Html.PagedListPager(Model, page => Url.Action("Index", new
            {
                page,
                customerName = ViewBag.CustomerName,
                paymentStatus = ViewBag.PaymentStatus,
                orderDate = ViewBag.OrderDate
            }))
        </div>
    }
</div>
