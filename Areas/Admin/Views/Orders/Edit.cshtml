@model _25DH230146_MyStore.Models.Order

@{
    ViewBag.Title = "Cập nhật trạng thái đơn hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="container-fluid" style="padding: 20px;">
    <h2>CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG #@Model.OrderID</h2>
    <hr />

    @using (Html.BeginForm("Edit", "Orders", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.OrderID)

        <div class="form-group">
            <label class="control-label col-md-2">Khách hàng</label>
            <div class="col-md-6">
                <p class="form-control-static"><strong>@Model.Customer.CustomerName</strong></p>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Tổng tiền</label>
            <div class="col-md-6">
                <p class="form-control-static text-danger"><strong>@Model.TotalAmount.ToString("N0") VNĐ</strong></p>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Trạng thái mới</label>
            <div class="col-md-4">
                <select name="PaymentStatus" class="form-control">
                    <option value="Chưa thanh toán" @(Model.PaymentStatus == "Chưa thanh toán" ? "selected" : "")>Chưa thanh toán</option>
                    <option value="Chờ thanh toán" @(Model.PaymentStatus == "Chờ thanh toán" ? "selected" : "")>Chờ thanh toán</option>
                    <option value="Thanh toán tiền mặt" @(Model.PaymentStatus == "Thanh toán tiền mặt" ? "selected" : "")>Thanh toán tiền mặt</option>
                    <option value="Đang xử lý" @(Model.PaymentStatus == "Đang xử lý" ? "selected" : "")>Đang xử lý</option>
                    <option value="Đang vận chuyển" @(Model.PaymentStatus == "Đang vận chuyển" ? "selected" : "")>Đang vận chuyển</option>
                    <option value="Đã giao" @(Model.PaymentStatus == "Đã giao" ? "selected" : "")>Đã giao</option>
                    <option value="Đã hủy" @(Model.PaymentStatus == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-6" style="margin-top: 15px;">
                <button type="submit" class="btn btn-success">Lưu thay đổi</button>
                @Html.ActionLink("Hủy", "Details", new { id = Model.OrderID }, new { @class = "btn btn-default" })
            </div>
        </div>
    }
</div>
